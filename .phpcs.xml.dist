<?xml version="1.0"?>
<ruleset name="Myrk">
	<description>Myrk plugin — WordPress coding standards with project-specific exclusions.</description>

	<file>myrk.php</file>
	<file>uninstall.php</file>
	<file>src/</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="6.4" />

	<rule ref="WordPress">
		<!--
			PSR-4 autoloading requires PascalCase class filenames. Renaming to
			WP's hyphenated-lowercase convention would break the autoloader.
		-->
		<exclude name="WordPress.Files.FileName" />

		<!--
			Short array syntax [] is preferred over long-form array().
			This is a WPCS opinion we explicitly disagree with.
		-->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax" />

		<!--
			This plugin provides its own database layer and intentionally uses
			direct wpdb queries. Caching is handled at the application level
			where appropriate (e.g., Registry in-memory store).
		-->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery" />
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching" />
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange" />
	</rule>
</ruleset>
