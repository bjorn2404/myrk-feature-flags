{
    "name": "myrk/myrk",
    "description": "Enterprise feature flags for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit":           "^9.5",
        "brain/monkey":              "^2.6",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs":  "^3.0",
        "phpstan/phpstan":           "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wp-cli-stubs":        "^2.12",
        "yoast/phpunit-polyfills":       "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Myrk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Myrk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":             "phpunit --no-coverage",
        "test:unit":        "phpunit --testsuite unit --no-coverage",
        "test:integration": "phpunit --testsuite integration --no-coverage",
        "analyse":          "phpstan analyse src --level=5 --memory-limit=-1",
        "lint":             "phpcs"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    }
}
